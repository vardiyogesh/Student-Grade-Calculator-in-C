#include <stdio.h>

int main() {
    char name[50];
    float marks1, marks2, marks3, average;

    printf("Enter student name: ");
    scanf("%49s", name);

    printf("Enter marks in 3 subjects: ");
    scanf("%f %f %f", &marks1, &marks2, &marks3);

    average = (marks1 + marks2 + marks3) / 3.0f;

    printf("\n--- Student Result ---\n");
    printf("Name: %s\n", name);
    printf("Average Marks: %.2f\n", average);

    if (average >= 90)
        printf("Grade: A\n");
    else if (average >= 75)
        printf("Grade: B\n");
    else if (average >= 60)
        printf("Grade: C\n");
    else if (average >= 40)
        printf("Grade: D\n");
    else
        printf("Grade: F (Fail)\n");

    return 0;
}
